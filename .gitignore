# ========================================================
# SemesterOS — .gitignore
# Production-ready configuration for GitHub & Vercel
# ========================================================

# 1. Dependencies
node_modules/
.pnp
.pnp.js

# 2. Production Build Output (Vercel builds this on deployment)
dist/
dist-ssr/
build/
out/
*.local

# 3. Vercel Project Cache & Metadata
.vercel

# 4. Environment Variables & Credentials
.env
.env.production
.env.development
.env.local
.env.*.local

# 5. Logs & Debug Artifacts
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Temporary Files & Caches
.temp/
.tmp/
*.tmp
*.bak
*.tsbuildinfo

# 7. Code Coverage & Test Output
coverage/
*.lcov
.nyc_output/

# 8. Editor & IDE Configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# 9. Operating System & Cloud Drive Files (Windows / OneDrive / macOS)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
